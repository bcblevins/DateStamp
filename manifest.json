{
   "action": {
      "default_icon": "icon128.png",
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "run-insertInProgress": {
         "description": "Insert \"in progress\" stamp",
         "suggested_key": {
            "default": "Ctrl+I",
            "mac": "Command+I"
         }
      },
      "run-insertPendingStamp": {
         "description": "Insert pending stamp",
         "suggested_key": {
            "default": "Ctrl+Shift+D",
            "mac": "Command+Shift+D"
         }
      },
      "run-insertTimeStamp": {
         "description": "Insert time stamp",
         "suggested_key": {
            "default": "Ctrl+Shift+Y",
            "mac": "Command+Shift+Y"
         }
      }
   },
   "content_scripts": [ {
      "css": [ "content-styles.css" ],
      "js": [ "content-script.js" ],
      "matches": [ "https://*.ezyvet.com/*" ]
   } ],
   "description": "Inserts the current date and time at the cursor.",
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "19": "icon19.png",
      "32": "icon32.png",
      "38": "icon38.png",
      "48": "icon48.png"
   },
   "manifest_version": 3,
   "name": "Date Stamp",
   "permissions": [ "contextMenus", "activeTab", "scripting", "storage" ],
   "version": "0.91.0"
}
